# Supabase — create a project at https://supabase.com, then paste the values from
# Project Settings → API. Copy this file to .env.local for local development and
# add the same variables in Vercel → Project → Settings → Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Needed for the invite-user admin API route (creating accounts).
# NEVER expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
